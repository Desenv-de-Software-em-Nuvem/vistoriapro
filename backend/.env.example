# ============================================
# VistoriaPro Backend - Environment Variables
# ============================================
#
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA faça commit do arquivo .env com dados reais!

# ============= SERVIDOR =============
NODE_ENV=development
PORT=3000
DEBUG=vistoriapro:*

# ============= DATABASE =============
# PostgreSQL Connection String (PREFERIDO em produção)
# Formato: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vistoriapro

# OU use variáveis individuais (DESENVOLVIMENTO)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vistoriapro
DB_USER=postgres
DB_PASSWORD=postgres

# ============= AUTENTICAÇÃO =============
# JWT Secret - ALTERE PARA UM VALOR SEGURO EM PRODUÇÃO!
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ============= UPLOADS =============
# Diretório para uploads de arquivos
UPLOAD_DIR=uploads

# ============= CORS =============
# Origens permitidas (separadas por vírgula)
CORS_ORIGIN=http://localhost:3000