        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "vistoria_id": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "comodo_nome": {
            "type": "string"
          },
          "comodo_id": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
