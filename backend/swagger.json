        "required": [
          "vistoria_id",
          "url"
        ]
      },
      "Transcricao": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "vistoria_id": {
            "type": "integer"
          },
          "url_audio": {
            "type": "string"
          },
          "texto": {
            "type": "string"
          },
          "foto_id": {
            "type": "integer"
          },
          "comodo_nome": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "vistoria_id",
          "url_audio",
          "texto"
        ]
      },
      "LocatarioVistoria": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "vistoria_id": {
            "type": "integer"
          },
          "nome": {
            "type": "string"
          },
          "nacionalidade": {
            "type": "string"
          },
          "profissao": {
            "type": "string"
          },
          "cpf": {
            "type": "string"
          },
          "rg": {
            "type": "string"
          },
          "rg_orgao": {
            "type": "string"
          },
          "rg_uf": {
            "type": "string"
          },
          "endereco": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "vistoria_id",
          "nome"
        ]
      }
    }
